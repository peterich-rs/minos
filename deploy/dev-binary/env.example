# EnvironmentFile for systemd minos-backend (binary bypass).
#
# Install on VPS:
#   sudo cp env.example /opt/minos/deploy/backend.env
#   sudo chmod 600 /opt/minos/deploy/backend.env
#   sudo chown root:minos /opt/minos/deploy/backend.env
#
# Reuse the same secrets as /opt/minos/deploy/.env (Docker compose).
# Difference: Postgres/Redis hostnames are 127.0.0.1 (compose publishes
# loopback ports), NOT docker-compose service names (postgres/redis).
#
# Never commit a real backend.env.

# Bind loopback only — Caddy reverse_proxies :443 → here
MINOS_BACKEND_LISTEN=127.0.0.1:8787

MINOS_STORAGE_MODE=external-sql
# Same credentials as compose POSTGRES_* ; host is loopback publish
MINOS_DATABASE_URL=postgres://minos:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/minos

MINOS_CACHE_BACKEND=redis
MINOS_MESSAGE_BUS_BACKEND=redis
MINOS_REDIS_URL=redis://127.0.0.1:6379/

# openssl rand -hex 32  — must match whatever clients/hosts already trust
MINOS_JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_RANDOM

MINOS_ENV=prod
# Browser origins that call the API (no wildcard in prod)
MINOS_CORS_ORIGINS=https://minos.ainexc.com

MINOS_SHUTDOWN_TIMEOUT_SECS=30
RUST_LOG=info,minos_backend=info

# Optional: file logs under VPS layout
# MINOS_BACKEND_LOG_DIR=/opt/minos/logs/backend

# Optional Supabase exchange (only if used in this environment)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_JWT_AUD=authenticated
# SUPABASE_JWT_SECRET=
# SUPABASE_ANON_KEY=
