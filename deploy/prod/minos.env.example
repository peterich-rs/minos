# Single VPS env SSOT for Minos production layout.
#
# Install on VPS:
#   sudo install -m 640 -o root -g minos minos.env.example /opt/minos/deploy/minos.env
#   # edit secrets, then:
#   sudo ln -sfn /opt/minos/deploy/minos.env /opt/minos/deploy/.env
#   sudo systemctl daemon-reload && sudo systemctl restart minos-backend
#
# Consumers:
#   - systemd minos-backend: EnvironmentFile=/opt/minos/deploy/minos.env
#   - docker compose (Postgres/Redis, optional image backend): project .env → symlink to minos.env
#
# Binary mode uses loopback hosts (127.0.0.1) in MINOS_DATABASE_URL / MINOS_REDIS_URL.
# Docker minos-backend service does NOT read those URLs; compose builds
# postgres://…@postgres and redis://redis from POSTGRES_* itself.
#
# Never commit a real minos.env. systemd EnvironmentFile does not expand
# ${VAR} — keep POSTGRES_PASSWORD and the password inside MINOS_DATABASE_URL in sync.

# ── Data plane (docker compose postgres service) ────────────────────────────
POSTGRES_USER=minos
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=minos

# ── Optional: Docker backend image path (switch-to-docker / compose backend) ─
# Prefer immutable sha tags in prod. Not required while running systemd binary.
MINOS_BACKEND_IMAGE=ghcr.io/peterich-rs/minos-backend:latest

# ── App runtime (systemd binary; also used by compose env passthrough) ──────
# Bind loopback only — Caddy reverse_proxies :443 → here
MINOS_BACKEND_LISTEN=127.0.0.1:8787

MINOS_STORAGE_MODE=external-sql
# Same credentials as POSTGRES_*; host is loopback publish (not docker DNS name)
MINOS_DATABASE_URL=postgres://minos:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/minos

MINOS_CACHE_BACKEND=redis
MINOS_MESSAGE_BUS_BACKEND=redis
MINOS_REDIS_URL=redis://127.0.0.1:6379/

# openssl rand -hex 32 — must match whatever clients already trust
MINOS_JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_RANDOM

MINOS_ENV=prod
# Browser origins that call the API (no wildcard in prod)
MINOS_CORS_ORIGINS=https://minos.ainexc.com

MINOS_SHUTDOWN_TIMEOUT_SECS=30
RUST_LOG=info,minos_backend=info
MINOS_BACKEND_LOG_DIR=/opt/minos/logs/backend

# ── Supabase Auth (required for client login → Minos session exchange) ──────
# Dashboard project URL; enables POST /v1/auth/supabase via JWKS.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_AUD=authenticated
# Optional: only if access tokens are still HS256 (Settings → API → JWT Secret).
# Prefer leaving empty when the project uses ES256 JWKS.
# SUPABASE_JWT_SECRET=

# ── Optional: Cloudflare R2 for media blobs ─────────────────────────────────
# MINOS_R2_ACCOUNT_ID=
# MINOS_R2_ACCESS_KEY_ID=
# MINOS_R2_SECRET_ACCESS_KEY=
# MINOS_R2_BUCKET=minos-media
# MINOS_R2_ENDPOINT=
# MINOS_MEDIA_MAX_BYTES=10485760
# MINOS_MEDIA_PUBLIC_BASE_URL=https://minos.ainexc.com
