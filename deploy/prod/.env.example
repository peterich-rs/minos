# Production env for /opt/minos/deploy/.env
#   cp .env.example .env && chmod 600 .env
# Never commit the real .env. Never put monorepo source on the VPS.

# Prebuilt image from GHCR (prefer immutable sha tag in prod)
MINOS_BACKEND_IMAGE=ghcr.io/peterich-rs/minos-backend:latest

POSTGRES_USER=minos
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=minos

# openssl rand -hex 32
MINOS_JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_RANDOM

MINOS_ENV=prod
# Browser origins that call the API (no wildcard in prod)
MINOS_CORS_ORIGINS=https://minos.ainexc.com
RUST_LOG=info,minos_backend=info

# --- Optional: Cloudflare R2 for media blobs (images/files) ---
# Enable R2 in the Cloudflare dashboard first, create a bucket + API token
# with Object Read & Write on that bucket, then set:
# MINOS_R2_ACCOUNT_ID=your_cloudflare_account_id
# MINOS_R2_ACCESS_KEY_ID=...
# MINOS_R2_SECRET_ACCESS_KEY=...
# MINOS_R2_BUCKET=minos-media
# Optional override (default https://{account_id}.r2.cloudflarestorage.com):
# MINOS_R2_ENDPOINT=
# MINOS_MEDIA_MAX_BYTES=10485760
# Public origin for absolute download URLs (optional; clients can use relative paths):
# MINOS_MEDIA_PUBLIC_BASE_URL=https://minos.ainexc.com
