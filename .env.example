# Minos environment configuration (schema only — copy to `.env.local`).
#
# Local full-chain guide: docs/ops/local-full-chain.md
# `just` loads repo-root `.env.local`. Desktop/Web Vite use envDir = monorepo root.
#
# Public product origin: https://minos.ainexc.com
# (minos.fan-nn.top was an old tunnel hostname only — not for new work.)

# =============================================================================
# LOCAL profile (default)
# =============================================================================

MINOS_BACKEND_LISTEN=127.0.0.1:8787
MINOS_BACKEND_DB=./minos-backend.db
# openssl rand -hex 32
MINOS_JWT_SECRET=replace-me-with-32-byte-random-string
MINOS_CORS_ORIGINS=*
MINOS_ENV=dev
RUST_LOG=info,minos_backend=info

MINOS_BACKEND_URL=ws://127.0.0.1:8787/devices
VITE_MINOS_BACKEND_URL=http://127.0.0.1:8787

# Supabase Auth (required)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-or-publishable-key>
SUPABASE_JWT_AUD=authenticated
# SUPABASE_JWT_SECRET=
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# =============================================================================
# PROD public hub (VPS + Caddy)
# =============================================================================
MINOS_PROD_ORIGIN=https://minos.ainexc.com
MINOS_PROD_WS=wss://minos.ainexc.com
# When clients talk to prod instead of local:
# MINOS_BACKEND_URL=wss://minos.ainexc.com/devices
# VITE_MINOS_BACKEND_URL=https://minos.ainexc.com
# MINOS_CORS_ORIGINS=https://minos.ainexc.com

MINOS_VPS_SSH=root@YOUR_VPS_IP
MINOS_VPS_DEPLOY_HOST=root@YOUR_VPS_IP
