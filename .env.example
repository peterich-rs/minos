# Minos environment configuration (schema only — copy to `.env.local`).
#
# SSOT for local full-chain: docs/ops/local-full-chain.md
# `just` auto-loads `.env.local` from the repo root.
# Desktop/Web Vite load the same file via vite `envDir` = monorepo root.

# =============================================================================
# LOCAL profile (default for full-chain smoke)
# =============================================================================

MINOS_BACKEND_LISTEN=127.0.0.1:8787
MINOS_BACKEND_DB=./minos-backend.db
# Generate: openssl rand -hex 32  (≥32 bytes)
MINOS_JWT_SECRET=replace-me-with-32-byte-random-string
MINOS_CORS_ORIGINS=*
MINOS_ENV=dev
RUST_LOG=info,minos_backend=info

# Clients → local hub
MINOS_BACKEND_URL=ws://127.0.0.1:8787/devices
VITE_MINOS_BACKEND_URL=http://127.0.0.1:8787

# Supabase Auth (required — password Minos paths removed)
# Dashboard Site URL: http://localhost:5173
# Redirects: http://localhost:5173/** and http://localhost:1420/**
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-or-publishable-key>
SUPABASE_JWT_AUD=authenticated
# SUPABASE_JWT_SECRET=   # only if HS256 verify needs it
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Domains / VPS (reference; not required for LOCAL)
MINOS_PROD_ORIGIN=https://minos.ainexc.com
MINOS_PROD_WS=wss://minos.ainexc.com
MINOS_TUNNEL_ORIGIN=https://minos.fan-nn.top
MINOS_TUNNEL_WS=wss://minos.fan-nn.top/devices
MINOS_VPS_SSH=root@YOUR_VPS_IP
MINOS_VPS_DEPLOY_HOST=root@YOUR_VPS_IP

# Cloudflare Access (only when dialing tunnel hostname)
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
