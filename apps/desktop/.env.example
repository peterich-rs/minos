# Minos Desktop — cloud account + Host Link (copy to .env.local; never commit secrets)

# Backend HTTP origin used for Supabase exchange, session refresh, and Host Link.
VITE_MINOS_BACKEND_URL=http://127.0.0.1:8787
# Production example:
# VITE_MINOS_BACKEND_URL=https://minos.ainexc.com

# Optional Supabase Auth (email/password IdP). When both are set, Desktop signs
# in via Supabase then POSTs /v1/auth/supabase for a Minos session.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon-key>

# When Supabase vars are unset, Desktop falls back to Minos /v1/auth/login
# (transitional password path).
