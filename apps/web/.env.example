# Local dev
VITE_MINOS_BACKEND_URL=http://127.0.0.1:8787
# Production: VITE_MINOS_BACKEND_URL=https://minos.ainexc.com

# Supabase Auth (optional). When both are set, Web uses Supabase as IdP
# and exchanges the access_token via POST /v1/auth/supabase.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon-key>
#
# Backend (same machine / process env, not Vite):
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_JWT_AUD=authenticated
# SUPABASE_JWT_SECRET=<legacy JWT secret from Dashboard → Settings → API>
#   Required when access tokens are still HS256 (common). Optional if tokens are ES256-only.
# MINOS_JWT_SECRET=<at-least-32-bytes>
