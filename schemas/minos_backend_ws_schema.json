{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Generated websocket contract for the Minos formal topic gateway (ClientFrame / ServerFrame).",
  "examples": {
    "durable_event": {
      "event_id": "evt-1",
      "kind": "message_created",
      "payload": {
        "message_id": "msg-1"
      },
      "topic": "conversation:conv-1",
      "topic_seq": 42,
      "type": "durable_event"
    },
    "hello": {
      "conn_id": "11111111-1111-1111-1111-111111111111",
      "heartbeat_interval_ms": 25000,
      "server_time_ms": 1700000000000,
      "type": "hello"
    },
    "ping": {
      "ts": 1700000000000,
      "type": "ping"
    },
    "pong": {
      "server_time_ms": 1700000000100,
      "ts": 1700000000000,
      "type": "pong"
    },
    "stream_event": {
      "kind": "ui_event",
      "payload": {
        "message_id": "m1",
        "text": "hi",
        "type": "text_delta"
      },
      "seq": 1,
      "topic": "agent_session:sess-1",
      "type": "stream_event"
    },
    "subscribe": {
      "topics": [
        "account:acct-1"
      ],
      "type": "subscribe"
    },
    "subscribe_ack": {
      "topics": [
        "account:acct-1"
      ],
      "type": "subscribe_ack"
    }
  },
  "gateways": [
    {
      "auth": "realtime_ticket",
      "client_frame_schema_ref": "#/schemas/ClientFrame",
      "example_names": [
        "durable_event",
        "hello",
        "ping",
        "pong",
        "stream_event",
        "subscribe",
        "subscribe_ack"
      ],
      "path": "/ws/client",
      "probe_path": "/ws/client",
      "server_frame_schema_ref": "#/schemas/ServerFrame",
      "surface": "client_gateway"
    },
    {
      "auth": "realtime_ticket",
      "client_frame_schema_ref": "#/schemas/ClientFrame",
      "example_names": [
        "durable_event",
        "hello",
        "ping",
        "pong",
        "stream_event",
        "subscribe",
        "subscribe_ack"
      ],
      "path": "/ws/host",
      "probe_path": "/ws/host",
      "server_frame_schema_ref": "#/schemas/ServerFrame",
      "surface": "host_gateway"
    }
  ],
  "schemas": {
    "ClientFrame": {
      "oneOf": [
        {
          "properties": {
            "client_request_id": {
              "type": "string"
            },
            "resume_after": {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            "topics": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "const": "subscribe"
            }
          },
          "required": [
            "type",
            "topics"
          ],
          "title": "Subscribe",
          "type": "object"
        },
        {
          "properties": {
            "topics": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "const": "unsubscribe"
            }
          },
          "required": [
            "type",
            "topics"
          ],
          "title": "Unsubscribe",
          "type": "object"
        },
        {
          "properties": {
            "ts": {
              "type": "integer"
            },
            "type": {
              "const": "ping"
            }
          },
          "required": [
            "type",
            "ts"
          ],
          "title": "Ping",
          "type": "object"
        },
        {
          "properties": {
            "ack_at_ms": {
              "type": "integer"
            },
            "command_id": {
              "type": "string"
            },
            "type": {
              "const": "host_command_ack"
            }
          },
          "required": [
            "type",
            "command_id",
            "ack_at_ms"
          ],
          "title": "HostCommandAck",
          "type": "object"
        },
        {
          "properties": {
            "batch": true,
            "type": {
              "const": "host_ingest_live_batch"
            }
          },
          "required": [
            "type",
            "batch"
          ],
          "title": "HostIngestLiveBatch",
          "type": "object"
        }
      ]
    },
    "ServerFrame": {
      "oneOf": [
        {
          "properties": {
            "conn_id": {
              "type": "string"
            },
            "heartbeat_interval_ms": {
              "type": "integer"
            },
            "server_time_ms": {
              "type": "integer"
            },
            "type": {
              "const": "hello"
            }
          },
          "required": [
            "type",
            "conn_id",
            "server_time_ms",
            "heartbeat_interval_ms"
          ],
          "title": "Hello",
          "type": "object"
        },
        {
          "properties": {
            "server_time_ms": {
              "type": "integer"
            },
            "ts": {
              "type": "integer"
            },
            "type": {
              "const": "pong"
            }
          },
          "required": [
            "type",
            "ts",
            "server_time_ms"
          ],
          "title": "Pong",
          "type": "object"
        },
        {
          "properties": {
            "client_request_id": {
              "type": "string"
            },
            "topics": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "const": "subscribe_ack"
            }
          },
          "required": [
            "type",
            "topics"
          ],
          "title": "SubscribeAck",
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "type": "string"
            },
            "payload": true,
            "seq": {
              "type": "integer"
            },
            "topic": {
              "type": "string"
            },
            "type": {
              "const": "stream_event"
            }
          },
          "required": [
            "type",
            "topic",
            "kind",
            "payload"
          ],
          "title": "StreamEvent",
          "type": "object"
        },
        {
          "properties": {
            "event_id": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            },
            "payload": true,
            "topic": {
              "type": "string"
            },
            "topic_seq": {
              "type": "integer"
            },
            "type": {
              "const": "durable_event"
            }
          },
          "required": [
            "type",
            "topic",
            "topic_seq",
            "kind",
            "payload",
            "event_id"
          ],
          "title": "DurableEvent",
          "type": "object"
        }
      ]
    }
  },
  "service": "minos-backend",
  "transport": "websocket",
  "version": "0.1.0"
}
